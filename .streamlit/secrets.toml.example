# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud: App settings > Secrets.
TURBOPUFFER_API_KEY = "tpuf_..."
TURBOPUFFER_REGION = "aws-us-east-1"

# Optional: turns on the copilot
# ANTHROPIC_API_KEY = "sk-ant-..."
# COPILOT_MODEL = "claude-sonnet-5-5"

# Optional: block note edits on a public deployment
# READ_ONLY = "true"
